# 复制成 .env 后填写。.env 不进 git（见 .gitignore 第一段）。
# ⚠️ 不要把 ~/.claude/settings.json 整份拷贝到本目录 —— 它同时含明文 token 和桌面宠物 hook。

# ---------- 企业微信（智能机器人 · 长连接）----------
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 白名单：只允许这些 userid 指挥。多个用逗号分隔。
# 这是相对 Pi Hub 实现的核心新增项 —— @ 只是消息路由，不是鉴权。
# ⚠️ 留空 = **拒绝启动**（fail-closed）。想开放给所有人，就显式写下面那个开关。
WECOM_ALLOWED_USERIDS=

# 真正的"任何人都能指挥它"开关。只有设成 1，空白名单才会放行。
# 默认不存在这一行 ⇒ 忘配白名单 = 起不来，而不是"默默对所有人开放"。
# WECOM_ALLOW_ANYONE=1

# 可选：限定只在这些 chatid 里工作（群聊的 chatid）。
WECOM_ALLOWED_CHATIDS=

# 机器人在企微里显示的名字。用于剥掉正文开头的 "@CC BOT"（企微下发的正文**带着**它）。
WECOM_BOT_NAME=CC BOT

# 审批卡片「处理」一行显示的名字：`userid=显示名`，多个用逗号分隔。
# 例：WECOM_USER_LABELS=zhangsan=张三,lisi=李四
# ⚠️ 企微回调里 `from` **只有 userid、没有昵称**（改群昵称也不影响 userid），
#    所以不配这一项的话，卡片上会显示脱敏形式（如 `z***`）——
#    这是有意的：卡片在群里所有人都看得见，账号 ID 不该直接摆在上面。
WECOM_USER_LABELS=

# ---------- Claude Code ----------
# 留空 = 默认 ~\.local\bin\claude.exe（桥自己 expanduser，能用）。
# ⚠️ **`.env` 不做变量展开** —— 写 `%USERPROFILE%\...` 会被当成字面路径，启动即失败。
# 要显式指定就写**展开后的绝对路径**，例如 C:\Users\yourname\.local\bin\claude.exe
# 用 `where claude` 能找到准确路径。
CC_CLAUDE_EXE=

# 启动目录。一个 session 与一个 cwd 绑定；改 cwd 等于换一套项目和 memory。
CC_CWD=C:\path\to\WeCom-Agent-Bridge

# 权限档位。合法值：acceptEdits / auto / bypassPermissions / manual / dontAsk / plan
# ⚠️ 没有 "default" 这个值（实测 --help），传不存在的值会启动即失败。
# 实测：bypassPermissions **单独可用**，不需要再加 --dangerously-skip-permissions。
#
# 各档在 **headless（-p）** 下到底拦不拦得住 —— 实测，判据是"副作用是否发生"，
# 不是看模型怎么说（tools/probe_permission_modes.py，2026-10-28）：
#   plan              ← 不执行。但会往 ~/.claude/plans/ 写一份计划文件
#   dontAsk           ← 不执行，拒绝会进 permission_denials（桥会如实回报）。**本项目默认**
#   manual            ← 不执行（模型会先试几种写法，然后放弃）
#   acceptEdits       ← ⚠️ **照样执行 Bash 并写文件**，跟全自动没区别
#   auto              ← ⚠️ 同上
#   bypassPermissions ← 同上（对照组，就是这个档跑通了所有实测）
# ⇒ 想让它真干活，改成 bypassPermissions；只想问答/读代码，保持 dontAsk。
CC_PERMISSION_MODE=dontAsk

# 显式指定模型。**留空 = 用 CLI 默认**（一般够用）。
# 什么时候需要它：别名（haiku/sonnet/opus）会映射到一个具体模型，如果你的用法
# 需要更长上下文或别的变体，就在这里写死，避免"每轮上下文小一档"。
CC_MODEL=

# ---------- 认证（必须自带，不能用 ~/.claude/settings.json 的那份）----------
# 桥用 --setting-sources project,local 排掉 user 设置，以此挡掉桌面宠物的 13 组 hook；
# 代价是**认证也一起没了**（实测：排掉后报 "Not logged in"）。
# 所以把 settings.json 里 env 段的 ANTHROPIC_* 原样搬到这里：
#   .venv\Scripts\python.exe -X utf8 tools\env_from_settings.py
# （只搬 ANTHROPIC* 开头的键，写进本目录 .env；屏幕上只打键名和长度，不回显 token）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 其余 ANTHROPIC_DEFAULT_*_MODEL 别名按需补；不补就由 CC_MODEL / ANTHROPIC_MODEL 决定。

# 加载哪些设置源（user,project,local）。
# **留空 = 用代码默认值 `project,local`（不含 user）** —— 这是本项目的推荐值，
# 也就是"能挡掉 13 组桌面宠物 hook"的那一档（`cfg()` 把空值当未设置，见 `main()`）。
# ⚠️ 排掉 user 会**同时失去 `~/.claude/settings.json` 里的认证** ⇒ 认证必须由本文件
# 注入到进程环境变量里（见上面的 ANTHROPIC_* 与 §4 实测项）。
# 想让桥重新加载 user 设置，显式写：CC_SETTING_SOURCES=user,project,local
CC_SETTING_SOURCES=

# 允许 / 拒绝的工具。留空表示不传该参数。
# CC_ALLOWED_TOOLS=Read,Grep,Glob
# CC_DISALLOWED_TOOLS=Read(**/.env),Read(**/.ssh/**),Bash(git push:*)

# ---------- 官方 wecom-cli（可选：企业能力 = Agent 的「手」）----------
# 装了 `npm i -g @wecom/cli` 并 `wecom-cli auth init` 之后填这个目录：
#   WECOM_CLI_CONFIG_DIR=C:\path\to\WeCom-Agent-Bridge\data\wecom-cli-cc
# 用独立目录，是为了“一台机器上有多个机器人时，各自用各自的身份”。
# ⚠️ 权限档是 dontAsk 时模型仍然跑不了它（实测 --allowedTools 也放不进来）。
WECOM_CLI_CONFIG_DIR=
#
# 装了官方 `wecom-cli`（见 CLAUDE.md「企业微信能力」）时，把它加进允许列表，
# 模型才能调用它发消息 / 写文档 / 查通讯录。它**只影响"要不要弹确认"**：
# 权限档是 dontAsk 时 Bash 一律被拒，光加这行不会放行。
CC_ALLOWED_TOOLS=
# 例：CC_ALLOWED_TOOLS=Bash(wecom-cli:*)
CC_DISALLOWED_TOOLS=

# ---------- 运行参数 ----------
# 单条消息的总超时（秒）。超时要回「结果未知」，不能报成失败。
CC_TIMEOUT_SEC=600

# 内部交接队列的上限。**注意：忙碌时新消息是直接丢弃、不排队的**
# （用户 2026-10-27 决定，防输入轰炸）⇒ 队列里最多只会有一条，此项只是兜底上限。
QUEUE_MAX=20

# 长文本的**切分粒度**（UTF-8 字节），不是"超过就切"。
# 发送顺序：先整条发 → 只有平台回 errcode 40058（实测上限 20480）才按这个粒度切开重发。
# ⇒ 3000 字的回答（≈9 KB）是一条，不会被拆成 (1/2)(2/2)。
CHUNK_BYTES=18000

# 回复尾部附上下文占用（1/0）。分母取自 claude JSON 的 contextWindow，不猜。
CC_SHOW_USAGE=1

# 任务跑超过 N 秒时补一条"还在跑"。0 = 关。
# ⚠️ 这条只在**没有流式气泡**时生效（回调没带 req_id 的退化路径）。
# 有气泡时进度由下面的真进度机制负责，两套不会同时刷。
CC_PROGRESS_SEC=90

# 真进度气泡的**兜底心跳**间隔（秒）。0 = 只在"工具/目标变了"时推。
# runner 增量读 `stream-json`，每读到一次工具调用就把气泡更新成
# 「⏳ 正在跑（12s · 第 3 步）🛠 读 app/bridge.py」。
# 只在变化时推是为了省限流额度（30 条/分钟、1000 条/小时）；这个间隔是
# "一直没变化也要让用户知道它还活着"的兜底。
CC_PROGRESS_HEARTBEAT_SEC=60

# ---------- 审批卡片（Phase 3，默认关）----------
# 打开之后：`Bash` / `Write` / `Edit` 这类**有副作用**的工具调用会先发一张
# 「允许 / 拒绝」卡片，点了才执行。只读工具直接放行。
# ⚠️ 三条必须知道的（测量结论，见 notes/DECISIONS §25）：
#   ① 它只在**能执行命令的档位**下有意义（`bypassPermissions`）；`dontAsk` 下
#      就算点了「允许」命令也跑不起来 —— 所以它是"全自动之后的第二道闸"，
#      **不是**让全自动变安全的东西。
#   ② harness 的超时是**放行**，所以否决权在 `tools/approval_hook.py` 自己手里：
#      它自己等 CC_APPROVAL_WAIT_SEC 秒，到点自己拒绝。
#   ③ 桥启动时有两道自检：静态查 `.claude/settings.json` 有没有注册这个 hook，
#      再跑一次假事件、要求 hook 真写出请求。**任一不过就拒绝启动**（退出码 5），
#      **不会**降级成"没有审批的全自动" —— 否则就是"假装有闸门"。
CC_APPROVAL=0
CC_APPROVAL_WAIT_SEC=120
# 只读直放名单（逗号分隔，按工具名）。别把 Bash/Write 放进来。
CC_APPROVAL_ALLOW=Read,Grep,Glob,TodoWrite
# 决策文件的目录。留空 = data/approvals（不进 git）。
# CC_APPROVAL_DIR=

# 桥运行期间阻止 Windows 睡眠（不阻止关屏），保证长连接一直在。1/0。
# ⚠️ 挡不住**合盖睡眠** —— 那要在电源选项里把"关闭盖子时"设成"不采取任何操作"。
CC_KEEP_AWAKE=1

# 连接惰性检测：订阅后连续多少秒**没有收到任何帧**就主动断开重连。0 = 关闭。
# 实测（2026-10-27）：平台对每个 ping 都回一个 83 B、无 cmd 字段的帧，间隔 30 秒
# ⇒ 90 秒 = 连丢 3 个心跳才判死。见 notes/DECISIONS §14。
CC_STALE_RX_SEC=90

# SQLite 路径（可留空，默认 data/bridge.db）
CC_DB=