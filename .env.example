# 复制成 .env 后填写。.env 不进 git（见 .gitignore 第一段）。
# ⚠️ 不要把 ~/.claude/settings.json 整份拷贝到本目录 —— 它同时含明文 token 和桌面宠物 hook。

# ---------- 平台选择 ----------
# `wecom`（默认）/ `feishu` / `slack`。入口按这个值装配不同的适配器，**入口命令不变**。
# ⚠️ 改了它要重启桥才生效；而如果桥是**自启**的，重启那一刻就会切成新平台 ——
#    临时试另一个平台请用环境变量覆盖（不改文件）：
#    PLATFORM=feishu .venv\Scripts\python.exe -X utf8 app\bridge.py
# ⚠️ 各平台用**各自的单实例锁**，可以同时跑；同一个平台起两份会被锁挡住
#    （同一应用的多条长连接是"分摊事件"，不是广播）。
PLATFORM=wecom

# ---------- 企业微信（智能机器人 · 长连接）----------
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 白名单：只允许这些 userid 指挥。多个用逗号分隔。
# 这是相对 Pi Hub 实现的核心新增项 —— @ 只是消息路由，不是鉴权。
# ⚠️ 留空 = **拒绝启动**（fail-closed）。想开放给所有人，就显式写下面那个开关。
WECOM_ALLOWED_USERIDS=

# 真正的"任何人都能指挥它"开关。只有设成 1，空白名单才会放行。
# 默认不存在这一行 ⇒ 忘配白名单 = 起不来，而不是"默默对所有人开放"。
# WECOM_ALLOW_ANYONE=1

# 可选：限定只在这些 chatid 里工作（群聊的 chatid）。
WECOM_ALLOWED_CHATIDS=

# 机器人在企微里显示的名字。用于剥掉正文开头的 "@CC BOT"（企微下发的正文**带着**它）。
WECOM_BOT_NAME=CC BOT

# 审批卡片「处理」一行显示的名字：`userid=显示名`，多个用逗号分隔。
# 例：WECOM_USER_LABELS=zhangsan=张三,lisi=李四
# ⚠️ 企微回调里 `from` **只有 userid、没有昵称**（改群昵称也不影响 userid），
#    所以不配这一项的话，卡片上会显示脱敏形式（如 `z***`）——
#    这是有意的：卡片在群里所有人都看得见，账号 ID 不该直接摆在上面。
WECOM_USER_LABELS=

# ---------- 飞书（企业自建应用 · 长连接）----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 白名单：只允许这些 **open_id** 指挥。多个用逗号分隔。
# ⚠️ 口径是 open_id，不是手机号/邮箱/昵称：
#    · 它是**应用内唯一** ⇒ 换一个飞书应用（换 app_id）就要重填一遍；
#    · 但**发版不会变**（2026-11-05 实测：后台改机器人头像触发发版，open_id 逐字符未变）。
# 不知道自己的 open_id？让机器人收到你一条消息后，看日志里那行
# `[feishu][shape]`（打的是脱敏形式），或用 tools/feishu_whoami.py 直接写进本文件。
# ⚠️ 留空 = 拒绝启动（fail-closed），与企微同一套规则。
FEISHU_ALLOWED_OPENIDS=

# 真正的"任何人都能指挥它"开关。只有设成 1，空白名单才会放行。
# FEISHU_ALLOW_ANYONE=1

# 可选：限定只在这些群 chatid（`oc_…`）里工作。
# ⚠️ 只对**群聊**生效；单聊的推送目标是 open_id，不参与这项比对。
FEISHU_ALLOWED_CHATIDS=

# 机器人在飞书里显示的名字（卡片标题用）。
FEISHU_BOT_NAME=CC BOT

# 审批卡「处理」一行显示的名字：`open_id=显示名`。
# 不配就显示脱敏形式（如 `ou_cee***`）—— 卡片在群里所有人都看得见。
FEISHU_USER_LABELS=

# 超长文本的**切分粒度**（字节）。飞书单条上限实测 153,600 B（150 KiB）。
# ⚠️ 别照抄企微的 18000：那会把一条 60 KB 的回答无谓地拆成四片。
FEISHU_CHUNK_BYTES=130000

# ---------- Slack（Socket Mode · 长连接）----------
# 状态：适配器已实现并通过真机验收（单聊 / 频道 / 审批卡 / 断网自愈）。
#
# 要两个 token，来源不同，缺一不可：
#   SLACK_APP_TOKEN = App-Level Token（xapp-…）
#       位置：Basic Information → App-Level Tokens → Generate Token and Scopes
#       scope 必须有 `connections:write`（Socket Mode 建连）
#   SLACK_BOT_TOKEN = Bot User OAuth Token（xoxb-…）
#       位置：OAuth & Permissions → Install to Workspace 之后才出现
#       用来调 chat.postMessage / chat.update / chat.delete
#
# ⚠️ 不要填 user token（`xoxp-` / `xoxe.` 开头）：那是"以你的身份"说话，
#    机器人身份不成立；带 refresh 的轮换版 **12 小时就过期**，常驻桥会每天死一次。
#    真拿到了那一对，去 OAuth & Permissions 关掉 Token Rotation、重新 Install 换回 xoxb-。
# ⚠️ App ID（`A0…`）只做标识、不参与鉴权，填了也不影响运行。
SLACK_APP_ID=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# 白名单：只允许这些 **member ID（U…）** 指挥。多个用逗号分隔。
# 口径是 member ID，不是 @handle / 昵称 —— handle 能改、能被别人抢，member ID 不会。
# 自己的 ID：Slack 里点自己头像 → Profile → ⋯ → Copy member ID。
# ⚠️ 留空 = 拒绝启动（fail-closed），与企微、飞书同一套规则。
SLACK_ALLOWED_USERIDS=

# 真正的"任何人都能指挥它"开关。只有设成 1，空白名单才会放行。
# SLACK_ALLOW_ANYONE=1

# 可选：限定只在这些频道 ID（`C…` 公开/私有频道、`D…` 单聊）里工作。
# ⚠️ Slack 的**单聊本身就是一条频道**（`D…`），所以这一项同时管单聊与群聊 ——
#    不像企微/飞书那样要分成 chatid 和 open_id 两项。
SLACK_ALLOWED_CHANNELIDS=

# 机器人在 Slack 里显示的名字（卡片标题用）。
SLACK_BOT_NAME=CC BOT

# 审批卡「处理」一行显示的名字：`U…=显示名`，多个用逗号分隔。
# 不配就显示脱敏形式（如 `U0AB***`）—— 卡片在频道里所有人都看得见。
SLACK_USER_LABELS=

# 代理。**不是必填** —— 直连能不能通取决于当时网络，会变，必须现测。
#   · 2026-11-07 实测：slack.com:443 直连超时（同刻百度/GitHub/飞书/企微都正常）；
#   · 2026-11-08 复测：关掉加速器后直连可达（AWS 东京、TLS 1.3、api.test 200），
#     同一台机器不配本项也能建起 Socket Mode 并收发消息。
#   ⇒ 最常见的情形是"直连能通但不稳、加速器更稳"。所以默认留空，不通再填。
# 格式 `http://host:port`，例：http://127.0.0.1:12450
# ⚠️ 配了它 = **强制走代理**：代理一倒桥就全哑，即使直连本来是通的。
#    如果本机加速器是 TUN/虚拟网卡模式（流量在系统层被接管），这一项**多余**，
#    反而会在加速器关闭时把桥弄死 —— 这种情况请留空。
# ⚠️ 它**同时**管 HTTP API 与 Socket Mode 长连接。后者（websocket-client）
#    不认 HTTPS_PROXY 环境变量，代码里是显式传的 —— 只设环境变量会出现
#    "API 通了、事件一条都不来"，而且日志看起来像连上了。
# 留空 = 直连。
SLACK_PROXY=

# 超长文本的切分粒度。⚠️ **口径是字符，不是字节**（Slack 的限制按字符算）：
#    `chat.postMessage` 建议 ≤4,000 字符、`chat.update` 上限 4,000 字符；
#    超过 **40,000 字符会被静默截断**（`ok` 照样是 true，只多一条 message_truncated 警告）。
#    ⇒ 照抄企微的 18000（字节）会把中文回答切得没必要地碎。
#    另：`chat.postMessage` 官方限 **1 条/秒/频道**，分片之间会自动节流。
SLACK_CHUNK_CHARS=3800

# ---------- Claude Code ----------
# 留空 = 默认 ~\.local\bin\claude.exe（桥自己 expanduser，能用）。
# ⚠️ **`.env` 不做变量展开** —— 写 `%USERPROFILE%\...` 会被当成字面路径，启动即失败。
# 要显式指定就写**展开后的绝对路径**，例如 C:\Users\yourname\.local\bin\claude.exe
# 用 `where claude` 能找到准确路径。
CC_CLAUDE_EXE=

# 启动目录。一个 session 与一个 cwd 绑定；改 cwd 等于换一套项目和 memory。
# 🚨 **别填本仓库的目录**。桥目录里有三样东西不该摆在 Agent 手边：
#    .env（Bot Secret / 白名单 / 账号 ID）、logs/（每条消息的正文和 userid）、
#    data/（SQLite：会话映射、已见消息）。
#    给机器人单开一个空目录，要它在哪干活再切过去 —— 见教程 §6.11。
CC_CWD=C:\work\agent-workspace

# 私聊（单聊）专用的启动目录。留空 = 跟群聊共用 CC_CWD（老行为）。
# 设了之后：群聊还在 CC_CWD，私聊在那个目录里干活 —— 各自加载各自的
# CLAUDE.md / 项目 memory / 会话，互不串。
# ⚠️ 换目录后旧会话**无法 resume**（会话文件按 cwd 分目录存），桥会当场新建一个
#    并记在日志里，不会静默失忆。
# ⚠️ 目录不存在时桥**拒绝启动**，不会"静默回落到 CC_CWD"（那会让 Agent 在用户
#    没预期的仓库里动手）。
# ⚠️ 若 CC_APPROVAL=1 且 CC_APPROVAL_DM 保持默认 1，这个目录也必须装好
#    .claude/settings.json + tools/approval_hook.py，否则启动自检不过（拒绝启动）。
# CC_CWD_DM=C:\path\to\another\project

# 权限档位。合法值：acceptEdits / auto / bypassPermissions / manual / dontAsk / plan
# ⚠️ 没有 "default" 这个值（实测 --help），传不存在的值会启动即失败。
# 实测：bypassPermissions **单独可用**，不需要再加 --dangerously-skip-permissions。
#
# 各档在 **headless（-p）** 下到底拦不拦得住 —— 实测，判据是"副作用是否发生"，
# 不是看模型怎么说（tools/probe_permission_modes.py，2026-10-28）：
#   plan              ← 不执行。但会往 ~/.claude/plans/ 写一份计划文件
#   dontAsk           ← 不执行，拒绝会进 permission_denials（桥会如实回报）。**本项目默认**
#   manual            ← 不执行（模型会先试几种写法，然后放弃）
#   acceptEdits       ← ⚠️ **照样执行 Bash 并写文件**，跟全自动没区别
#   auto              ← ⚠️ 同上
#   bypassPermissions ← 同上（对照组，就是这个档跑通了所有实测）
# ⇒ 想让它真干活，改成 bypassPermissions；只想问答/读代码，保持 dontAsk。
CC_PERMISSION_MODE=dontAsk

# 模型的**种子 / 兜底**值。日常切换不用改这里 —— 聊天里发 `/model` 就行。
# 什么时候需要它：
#   ① 首次启动（`data/model.json` 还不存在）⇒ 用它初始化真源；
#   ② `data/model.json` 读不出来 / 内容不合法 ⇒ 退到它（两个文件不会一起坏）。
# 留空 = 不传 `--model`，由 CLI 用它自己的默认模型。
CC_MODEL=

# 聊天里 `/model` 列出来的候选（逗号分隔）。
# ⚠️ 它只决定"列表里显示什么"，**不限制**你直接发任意模型名 ——
#    任意名字都会先做一次真实调用探测，通过才写进真源。
# 端点不提供模型枚举（实测 `GET /v1/models` 回 `404 Not support`），
# 所以这份名单只能人工维护；写错一项不影响运行，只是列表里多一行。
CC_MODELS=

# 真源文件的位置。留空 = `<仓库>/data/model.json`（`data/` 已在 .gitignore）。
# 换模型**不再需要重启桥**：Runner 每条消息现读一次，`/model` 改完下一条就生效。
CC_MODEL_FILE=

# 模型级的端点 / 上下文窗口 / 工作目录。留空 = `<仓库>/data/model_profiles.json`。
# 什么时候需要它：候选表里要放**不同端点**的模型（例如云端 + 本地 Ollama）。
# `ANTHROPIC_BASE_URL` / `AUTH_TOKEN` 是进程级的（`.env` 启动读一次），
# 光换模型名不会换端点 ⇒ 切过去会一直报 "Model not exist"。
# 格式（`env` 只允许 ANTHROPIC_* / CLAUDE_CODE_*，其他键会被丢弃并报错）：
#   {
#     "qwen3.5:9b-32k": {
#       "label": "本地 qwen3.5-9B · Ollama · 32K",
#       "env": {"ANTHROPIC_BASE_URL": "http://127.0.0.1:11434",
#               "ANTHROPIC_AUTH_TOKEN": "ollama",
#               "ANTHROPIC_API_KEY": "",
#               "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "32768"},
#       "cwd": "C:\\path\\to\\small\\project"
#     }
#   }
# ⚠️ `CLAUDE_CODE_MAX_CONTEXT_TOKENS` 对不认识的模型名是**必须**的：不给它，
#    CLI 会按 200K 规划自动压缩，而本地模型只有 32K ⇒ 上下文静默溢出、
#    系统提示被截断、模型突然"不会用工具了"。
# ⚠️ `cwd` 会让这个模型在**自己的目录**里跑；切模型时旧会话会被清掉
#    （Claude 的会话文件按 cwd 分目录存，换目录本来 resume 不上）。
CC_MODEL_PROFILES=

# ---------- 认证（必须自带，不能用 ~/.claude/settings.json 的那份）----------
# 桥用 --setting-sources project,local 排掉 user 设置，以此挡掉桌面宠物的 13 组 hook；
# 代价是**认证也一起没了**（实测：排掉后报 "Not logged in"）。
# 所以把 settings.json 里 env 段的 ANTHROPIC_* 原样搬到这里：
#   .venv\Scripts\python.exe -X utf8 tools\env_from_settings.py
# （只搬 ANTHROPIC* 开头的键，写进本目录 .env；屏幕上只打键名和长度，不回显 token）
# ⚠️ 换 API key / 换服务商 / 换工作区，**改完必须重启桥**：认证是进程启动时
#    一次性注入子进程环境的，运行期没有重载路径（和模型热切换是两套机制）。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 其余 ANTHROPIC_DEFAULT_*_MODEL 别名按需补；不补就由 CC_MODEL / ANTHROPIC_MODEL 决定。

# 加载哪些设置源（user,project,local）。
# **留空 = 用代码默认值 `project,local`（不含 user）** —— 这是本项目的推荐值，
# 也就是"能挡掉 13 组桌面宠物 hook"的那一档（`cfg()` 把空值当未设置，见 `main()`）。
# ⚠️ 排掉 user 会**同时失去 `~/.claude/settings.json` 里的认证** ⇒ 认证必须由本文件
# 注入到进程环境变量里（见上面的 ANTHROPIC_* 与 §4 实测项）。
# 想让桥重新加载 user 设置，显式写：CC_SETTING_SOURCES=user,project,local
CC_SETTING_SOURCES=

# 允许 / 拒绝的工具。留空表示不传该参数。
# CC_ALLOWED_TOOLS=Read,Grep,Glob
# CC_DISALLOWED_TOOLS=Read(**/.env),Read(**/.ssh/**),Bash(git push:*)

# ---------- 官方 wecom-cli（可选：企业能力 = Agent 的「手」）----------
# 装了 `npm i -g @wecom/cli` 并 `wecom-cli auth init` 之后填这个目录：
#   WECOM_CLI_CONFIG_DIR=C:\path\to\Agent-Ops-WeCom-Bridge\data\wecom-cli-cc
# 用独立目录，是为了“一台机器上有多个机器人时，各自用各自的身份”。
# ⚠️ 权限档是 dontAsk 时模型仍然跑不了它（实测 --allowedTools 也放不进来）。
WECOM_CLI_CONFIG_DIR=
#
# 装了官方 `wecom-cli`（见 CLAUDE.md「企业微信能力」）时，把它加进允许列表，
# 模型才能调用它发消息 / 写文档 / 查通讯录。它**只影响"要不要弹确认"**：
# 权限档是 dontAsk 时 Bash 一律被拒，光加这行不会放行。
CC_ALLOWED_TOOLS=
# 例：CC_ALLOWED_TOOLS=Bash(wecom-cli:*)
CC_DISALLOWED_TOOLS=

# ---------- 运行参数 ----------
# 单条消息的总超时（秒）。超时要回「结果未知」，不能报成失败。
CC_TIMEOUT_SEC=600

# 内部交接队列的上限。**注意：忙碌时新消息是直接丢弃、不排队的**
# （用户 2026-10-27 决定，防输入轰炸）⇒ 队列里最多只会有一条，此项只是兜底上限。
QUEUE_MAX=20

# 同时最多跑几个任务（**按会话**算：同一个会话永远串行，不同会话可以并行）。
# 2026-11-05 之前是全局串行 —— 群聊在跑时私聊发什么都回「忙碌中」。
# 每个任务是一个 claude 子进程（约 250MB），2 个够用、再多也读不过来。
CC_MAX_CONCURRENT=2

# 长文本的**切分粒度**（UTF-8 字节），不是"超过就切"。
# 发送顺序：先整条发 → 只有平台回 errcode 40058（实测上限 20480）才按这个粒度切开重发。
# ⇒ 3000 字的回答（≈9 KB）是一条，不会被拆成 (1/2)(2/2)。
CHUNK_BYTES=18000

# 回复尾部附上下文占用（1/0）。分母取自 claude JSON 的 contextWindow；
# 分子取本轮最后一次 assistant 调用的 usage，**不取 modelUsage 的累计值**。
CC_SHOW_USAGE=1

# 任务跑超过 N 秒时补一条"还在跑"。0 = 关。
# ⚠️ 这条只在**没有流式气泡**时生效（回调没带 req_id 的退化路径）。
# 有气泡时进度由下面的真进度机制负责，两套不会同时刷。
CC_PROGRESS_SEC=90

# 真进度气泡的**兜底心跳**间隔（秒）。0 = 只在"工具/目标变了"时推。
# runner 增量读 `stream-json`，每读到一次工具调用就把气泡更新成
# 「⏳ 正在跑（12s · 第 3 步）🛠 读 app/bridge.py」。
# 只在变化时推是为了省限流额度（30 条/分钟、1000 条/小时）；这个间隔是
# "一直没变化也要让用户知道它还活着"的兜底。
CC_PROGRESS_HEARTBEAT_SEC=60

# ---------- 审批卡片（Phase 3，默认关）----------
# 打开之后：`Bash` / `Write` / `Edit` 这类**有副作用**的工具调用会先发一张
# 「允许 / 拒绝」卡片，点了才执行。只读工具直接放行。
# ⚠️ 三条必须知道的（实测结论）：
#   ① 它只在**能执行命令的档位**下有意义（`bypassPermissions`）；`dontAsk` 下
#      就算点了「允许」命令也跑不起来 —— 所以它是"全自动之后的第二道闸"，
#      **不是**让全自动变安全的东西。
#   ② harness 的超时是**放行**，所以否决权在 `tools/approval_hook.py` 自己手里：
#      它自己等 CC_APPROVAL_WAIT_SEC 秒，到点自己拒绝。
#   ③ 桥启动时，每个会挂卡的工作区各有两道自检：静态查 `.claude/settings.json`
#      有没有注册这个 hook，再跑一次假事件、要求 hook 真写出请求。
#      **任一不过就拒绝启动**（退出码 5），**不会**降级成"没有审批的全自动"
#      —— 否则就是"假装有闸门"。
CC_APPROVAL=0
CC_APPROVAL_WAIT_SEC=120
# 只读直放名单（逗号分隔，按**工具名**）。别把 Bash/Write 放进来。
#     Bash 里的命令另有一层**命令级**判定（P1-1）：官方 CLI 标 `effect=read` 的
#     查询直放、写弹卡、表外按写。判据见 interop/dingtalk.md，快照在
#     interop/dws_effects.json（`dws` 升级后跑 tools/dws_effect_sync.py --check）。
CC_APPROVAL_ALLOW=Read,Grep,Glob,TodoWrite
# 决策文件的目录。留空 = data/approvals（不进 git）。
# CC_APPROVAL_DIR=

# 私聊是否也挂审批卡。1（默认）= 群聊 + 私聊都挂；0 = 私聊全自动（显式可选项）。
# ⚠️ 仅在 CC_APPROVAL=1 时有意义；CC_APPROVAL=0 时审批整体不启用。
# 设 0 后桥**不注入** CC_APPROVAL_DIR；本项目提供的 hook 在无 env 时立刻放行。
#    若私聊工作区用的是别的 PreToolUse hook，行为由那个 hook 决定（不一定是放行）。
# 设为 1 且私聊工作区与群聊不同时，桥启动会对**私聊工作区**也跑一遍静态 + 运行两道自检；
# 任一不过就拒绝启动（退出码 5）。
# CC_APPROVAL_DM=1

# 桥运行期间阻止 Windows 睡眠（不阻止关屏），保证长连接一直在。1/0。
# ⚠️ 挡不住**合盖睡眠** —— 那要在电源选项里把"关闭盖子时"设成"不采取任何操作"。
CC_KEEP_AWAKE=1

# 连接惰性检测：订阅后连续多少秒**没有收到任何帧**就主动断开重连。0 = 关闭。
# 实测（2026-10-27）：平台对每个 ping 都回一个 83 B、无 cmd 字段的帧，间隔 30 秒
# ⇒ 90 秒 = 连丢 3 个心跳才判死。
CC_STALE_RX_SEC=90

# SQLite 路径（可留空，默认 data/bridge.db）
CC_DB=

# ============================================================
# 飞书（Lark）· 自建应用
# ============================================================
# 只支持**企业自建应用**（长连接仅对自建应用开放）。
# 填法：`python -X utf8 tools/set_credentials.py` —— 交互式写入，
# 密钥输入不回显，也不会出现在终端历史里。
# 飞书适配器目前**未实现**（见 platforms/feishu/README.md 的待实测清单）。
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
